:8080 {
    @sourceIndex path /source /source/ /source/index.html
    redir @sourceIndex https://github.com/YapLgbt/Yappers/releases/tag/home-v0.1.1 302
    @sourceArchive path_regexp legacySource ^/source/([a-f0-9]{64}\.tar\.gz)$
    redir @sourceArchive https://github.com/YapLgbt/Yappers/releases/download/home-v0.1.0/{re.legacySource.1} 302

    @app path /app /app/*
    header @app {
        Cache-Control "no-cache"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' https: wss:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    header /.well-known/yap-home.json Cache-Control "no-store"
    root * /srv/yap-site
    encode zstd gzip
    file_server
}
