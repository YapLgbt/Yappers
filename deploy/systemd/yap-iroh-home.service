[Unit]
Description=Yap public home over Iroh
Wants=network-online.target
After=network-online.target

[Service]
Environment=YAP_PEERING_POLICY=/etc/yap/peering.json
Environment=YAP_SOURCE_BASE_URL=https://github.com/YapLgbt/Yappers/releases/download/home-v0.1.0
EnvironmentFile=-/var/lib/yap-iroh-replica/v6/push/environment
User=yap-iroh-replica
Group=yap-iroh-replica
ExecStartPre=/usr/bin/test -s /var/lib/yap-iroh-replica/standalone/public-home.json
ExecStart=/usr/local/lib/yap-iroh-replica/yappers-server-v6 public-home --directory /var/lib/yap-iroh-replica/standalone --manifest /var/lib/yap-iroh-replica/standalone/enrollment.json
WorkingDirectory=/var/lib/yap-iroh-replica
StateDirectory=yap-iroh-replica
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5
KillSignal=SIGINT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
