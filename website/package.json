{
  "name": "yap-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/offline-build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "axe-core": "4.11.0",
    "parse5": "8.1.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "bits-ui": "2.21.0",
    "material": "3.15.1"
  },
  "overrides": {
    "runed": {
      "@sveltejs/kit": "$@sveltejs/kit"
    }
  }
}
